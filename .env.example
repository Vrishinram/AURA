# =========================================================
# AI Safety Red Team Agent Configuration
# =========================================================

# Google Gemini API
GEMINI_API_KEY=your_gemini_api_key_here
DEFAULT_GEMINI_MODEL=gemini-2.5-flash

# OpenAI / OpenAI-Compatible (OpenAI, Groq, Together, DeepSeek, Local Ollama/vLLM)
OPENAI_API_KEY=your_openai_or_compatible_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
DEFAULT_OPENAI_MODEL=gpt-4o-mini

# Evaluator / Judge Configuration
# Provider used to evaluate safety outcomes (gemini, openai, heuristic, or mock)
EVALUATOR_PROVIDER=heuristic
EVALUATOR_MODEL=gemini-2.5-flash

# General Run Config
RUNS_DIR=data/runs
TIMEOUT_SECONDS=30
MAX_RETRIES=3
TEMPERATURE=0.0
